# ============================================================
#  Пример конфигурации для Telegram-видеобота
#  Скопируйте в .env и заполните своими значениями:
#      cp config_example.env .env
# ============================================================

# --- Данные из https://my.telegram.org (Api_id + Api_hash) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Токен бота от @BotFather ---
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Обязательная подписка: username каналов/чатов БЕЗ @, через запятую.
#     Можно указать и ID супергруппы вида -1001234567890 ---
REQUIRED_CHANNELS=my_channel,another_channel,news_chat

# --- Опционально: проверка запуска конкретного бота.
#     Пользователь должен нажать /start у этого бота.
#    留 пустым, чтобы отключить. ---
REQUIRED_BOT_USERNAME=some_verification_bot

# --- Лимиты размера файлов (продление лимитов Telegram) ---
# Лимит выдаёт сам Telegram по типу аккаунта, апгрейдится так:
#   Bot API (@BotFather)       -> 50 MiB   (увеличить нельзя)
#   MTProto-аккаунт            -> 2 GiB    (этот бот работает так)
#   + Telegram Premium         -> 4 GiB    (оформить на аккаунт-загрузчик
#                                           через @PremiumBot или подарком)
#   self-hosted дата-центр     -> до 4 GiB
# После покупки Premium перезапустите бота (или админ напишет /premium) —
# бот сам перечитает лимит у сервера и поднимет его.
#
# Жёсткий потолок одного файла (защита от ошибок диска), байт. По умолчанию 4 GiB.
MAX_FILE_SIZE=4294967296
# Целевой размер куска при нарезке файлов больше лимита, байт.
# По умолчанию = максимум Premium: файлы <= 4 GiB уходят целиком,
# режутся только файлы больше лимита аккаунта.
CHUNK_TARGET_SIZE=4294967296
# true, если на аккаунте-загрузчике уже куплен Premium, но флаг ещё не
# подтянулся (кэш get_me). По умолчанию false.
FORCE_PREMIUM=false

# --- Папка для временных файлов ---
DOWNLOAD_DIR=./downloads

# --- Приватные каналы: cookies.txt от аккаунта, который имеет доступ.
#     Оставьте пустым, если не нужно. ---
COOKIES_FILE=
