# ============================================================
#  Пример конфигурации для Telegram-видеобота
#  Скопируйте в .env и заполните своими значениями:
#      cp config_example.env .env
# ============================================================

# --- Данные из https://my.telegram.org (Api_id + Api_hash) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Токен бота от @BotFather ---
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Обязательная подписка: username каналов/чатов БЕЗ @, через запятую.
#     Можно указать и ID супергруппы вида -1001234567890 ---
REQUIRED_CHANNELS=my_channel,another_channel,news_chat

# --- Опционально: проверка запуска конкретного бота.
#     Пользователь должен нажать /start у этого бота.
#    留 пустым, чтобы отключить. ---
REQUIRED_BOT_USERNAME=some_verification_bot

# --- Максимальный размер файла для PREVIEW-режима (байт).
#     По умолчанию 2 GiB (лимит Bot API при скачивании через сервера Telegram).
#     Для upload на собственный сервер используйте 4 GiB = 4294967296 ---
MAX_FILE_SIZE=2147483648

# --- Папка для временных файлов ---
DOWNLOAD_DIR=./downloads

# --- Приватные каналы: cookies.txt от аккаунта, который имеет доступ.
#     Оставьте пустым, если не нужно. ---
COOKIES_FILE=
